<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="260.0" prefWidth="420.0" spacing="14.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SetupBattagliaController">
   <children>
      <Label text="Setup Battaglia">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label fx:id="pokemonSceltoLabel" text="Pokemon giocatore: -" />
      <Label text="Quanti Pokemon vuoi in campo? (min 2, max 151)" />
      <TextField fx:id="numeroPokemonField" maxWidth="120.0" promptText="Es: 6" />
      <Button fx:id="continuaButton" mnemonicParsing="false" onAction="#continuaVersoBattaglia" text="Avvia Battaglia" />
   </children>
   <padding>
      <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
   </padding>
</VBox>
