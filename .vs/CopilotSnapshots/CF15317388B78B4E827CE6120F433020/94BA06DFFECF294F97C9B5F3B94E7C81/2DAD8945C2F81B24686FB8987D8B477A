using System.ComponentModel;
using WinFormsLibraryVeicoli;

namespace WinFormsParcoVeicoli
{
    public partial class FormInizio : Form
    {
        BindingList<Veicolo> veicoli;
        public FormInizio()
        {
            InitializeComponent();
            veicoli = new BindingList<Veicolo>();
            dataGridViewVeicoli.DataSource = veicoli;
        }

        private void dataGridViewVeicoli_CellContentClick(object sender, DataGridViewCellEventArgs e)
        {
            Veicolo veicolo = veicoli[e.RowIndex];
            textBoxTarga.Text = veicolo.Targa.ToString();
            textBoxMarca.Text = veicolo.Marca.ToString();
            textBoxModello.Text = veicolo.Modello.ToString();
            textBoxChilometriPercorsi.Text = veicolo.ChilometriPercorsi.ToString();
            textBoxProprietà.Text = veicolo is Auto auto ? auto.NumeroPorte.ToString() : veicolo is Camion camion ? camion.CapacitaCarico.ToString() : string.Empty;
        }

        private void buttonElimina_Click(object sender, EventArgs e)
        {
            veicoli.RemoveAt(1);
        }

        private void buttonInserisci_Click(object sender, EventArgs e)
        {
            try
            {
                string targa = textBoxTarga.Text;
                string marca = textBoxMarca.Text;
                string modello = textBoxModello.Text;
                double chilometri = double.TryParse(textBoxChilometriPercorsi.Text, out double k) ? k : 0;

                Veicolo nuovo;
                string scelta = comboBoxScelta.SelectedItem?.ToString() ?? string.Empty;
                if (scelta == "Auto")
                {
                    int porte = int.TryParse(textBoxProprietà.Text, out int p) ? p : 4;
                    nuovo = new Auto(porte, targa, marca, modello, chilometri);
                }
                else // Camion o valore di fallback
                {
                    double capacita = double.TryParse(textBoxProprietà.Text, out double c) ? c : 0;
                    nuovo = new Camion(capacita, targa, marca, modello, chilometri);
                }

                veicoli.Add(nuovo);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Errore durante l'inserimento del veicolo: {ex.Message}");
            }
        }
    }
}
